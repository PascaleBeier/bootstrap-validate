---
import { Code } from "astro-expressive-code/components";
import RulePreview from "./RulePreview.astro";

const { rule, version } = Astro.props;
const hasOptions = rule.params.length > 0;
---

<p>{rule.description}</p>

<dl class="rule-detail-meta">
  <dt>Since</dt>
  <dd>{rule.since}</dd>
  <dt>Signature</dt>
  <dd><code>{rule.signature}</code></dd>
  <dt>Options</dt>
  <dd>{rule.params.length}</dd>
</dl>

<h2>Usage</h2>
<Code code={rule.usage} lang="js" meta={`title="${rule.name} usage"`} />

<h2>Options</h2>
{
  hasOptions ? (
    <table>
      <thead>
        <tr>
          <th>Name</th>
          <th>Description</th>
          <th>Example</th>
        </tr>
      </thead>
      <tbody>
        {rule.params.map((param, index) => (
          <tr>
            <td>
              <code>{param.name}</code>
            </td>
            <td>{param.description}</td>
            <td>{index === 0 ? <code>{rule.example}</code> : ""}</td>
          </tr>
        ))}
      </tbody>
    </table>
  ) : (
    <p>
      This rule only needs an error message after the rule name, for example{" "}
      <code>{rule.name}:{rule.error}</code>.
    </p>
  )
}

<RulePreview rule={rule} version={version} />

<h2>Source</h2>
<Code code={rule.source} lang="js" meta={`title="${rule.name} source"`} />
