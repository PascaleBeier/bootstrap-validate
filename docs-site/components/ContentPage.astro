---
import { Code } from "astro-expressive-code/components";

const { page, version } = Astro.props;
---

{
  page === "installation" && (
    <>
      <h2>Install the package</h2>
      <p>
        bootstrap-validate can be used from npm or as a browser script.
        Version 2.3.0 is the final Bootstrap 4 compatible release.
      </p>

      <h2>Package Managers</h2>
      <Code code="npm install bootstrap-validate" lang="bash" />

      <h2>Modern CDN</h2>
      <p>
        Prefer a maintained npm CDN for browser-only usage. Pin a version when
        you need reproducible builds.
      </p>
      <Code
        code={`<script src="https://cdn.jsdelivr.net/npm/bootstrap-validate@2.3.0/dist/bootstrap-validate.js"></script>`}
        lang="html"
      />

      <h2>Bundlers</h2>
      <Code
        code={`import bootstrapValidate from 'bootstrap-validate';

bootstrapValidate('#email', 'email:Enter a valid email address');`}
        lang="js"
      />

      {version.slug === "v3" && (
        <p>
          Version 3 is planned as the Bootstrap 5 refactor. Until it is
          released, use v2.3.0 for production Bootstrap 4 projects.
        </p>
      )}
    </>
  )
}

{
  page === "usage" && (
    <>
      <h2>Use bootstrapValidate()</h2>
      <p>
        The API is intentionally small. Pass an input selector or element, a
        rule string, and optionally a callback. Since v2.3.0, the call returns a
        validation handle.
      </p>

      <h2>The Function</h2>
      <Code
        code={`bootstrapValidate('#myInput', 'required:Please fill out this field!', function (isValid) {
  if (isValid) {
    console.log('Element is valid');
  }
});`}
        lang="js"
      />

      <h2>Selectors and Elements</h2>
      <p>
        The first argument works like <code>document.querySelector()</code>. You
        can pass an id, class, attribute selector, DOM element, or an array of
        selectors/elements.
      </p>
      <Code
        code={`bootstrapValidate(['#firstName', '#lastName'], 'max:20:Enter no more than 20 characters');`}
        lang="js"
      />

      <h2>Rules and Options</h2>
      <p>
        Separate multiple rules with <code>|</code>. Separate rule options with
        <code>:</code>. The final option is the error message.
      </p>
      <Code
        code={`bootstrapValidate('#email', 'required:Required|email:Enter a valid email');`}
        lang="js"
      />

      <h2>Submit Validation</h2>
      <p>
        Store the returned handles when a form must validate before submit.
      </p>
      <Code
        code={`const validators = [
  bootstrapValidate('#email', 'required:Email required|email:Enter a valid email'),
  bootstrapValidate('#password', 'required:Password required'),
];

document.querySelector('#account').addEventListener('submit', (event) => {
  const isValid = validators.map((validator) => validator.validate()).every(Boolean);
  if (!isValid) {
    event.preventDefault();
  }
});`}
        lang="js"
      />

      <h2>Remove Listeners</h2>
      <Code
        code={`const validator = bootstrapValidate('#email', 'email:Enter a valid email');
validator.destroy();`}
        lang="js"
      />

      <h2>Optional Fields</h2>
      <p>
        Empty fields pass non-required rules. Combine a rule with{" "}
        <code>required</code> when the field must be filled out.
      </p>
      <Code
        code={`bootstrapValidate('#website', 'url:Enter a valid URL');
bootstrapValidate('#email', 'required:Required|email:Enter a valid email');`}
        lang="js"
      />

      <h2>Regex Separators</h2>
      <p>
        Regex rules can contain pipes. Escape a pipe or colon when it would look
        like a rule separator.
      </p>
      <Code
        code={`bootstrapValidate(
  '#time',
  'regex:([0-9]|0[0-9]|1[0-9]|2[0-3]):([0-5][0-9])\\\\s*([AaPp][Mm]):Please enter a valid time'
);

bootstrapValidate('#slug', 'regex:foo\\\\|bar\\\\:baz:Invalid slug');`}
        lang="js"
      />

      <h2>Select and Select2</h2>
      <p>
        Native selects are validated on change. Select2 works by triggering the
        original select element's change event.
      </p>
      <Code
        code={`bootstrapValidate('#group', 'required:Choose a group');`}
        lang="js"
      />

      <h2>Custom Rules</h2>
      <p>
        Version 2 supports synchronous custom rules. Async checks belong in the
        v3 API.
      </p>
      <Code
        code={`bootstrapValidate.extendRule('evenLength', (input) => input.value.length % 2 === 0);
bootstrapValidate('#code', 'evenLength:Use an even number of characters');`}
        lang="js"
      />

      <h2>Rule Reference</h2>
      <p>Browse the available validation rules and copy ready-to-use examples.</p>
      <p>
        <a href={`/${version.slug}/rules/`}>Browse rules</a>
      </p>
    </>
  )
}

{
  page === "download" && (
    <>
      <h2>Download and archives</h2>
      <p>
        Download archived releases from GitHub or install the package from npm.
      </p>

      <h2>Latest Stable Package</h2>
      <Code code="npm install bootstrap-validate" lang="bash" />

      <h2>GitHub Releases</h2>
      <p>
        Release archives are available from the GitHub repository. Prefer pinned
        versions for production sites.
      </p>
      <ul>
        <li>
          <a href="https://github.com/PascaleBeier/bootstrap-validate/releases">
            All GitHub releases
          </a>
        </li>
        <li>
          <a href="https://www.npmjs.com/package/bootstrap-validate">
            npm package
          </a>
        </li>
      </ul>

      <h2>CDN</h2>
      <Code
        code={`<script src="https://cdn.jsdelivr.net/npm/bootstrap-validate@2/dist/bootstrap-validate.js"></script>`}
        lang="html"
      />
    </>
  )
}
