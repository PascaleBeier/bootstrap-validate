---
import StarlightPage from "@astrojs/starlight/components/StarlightPage.astro";
import { canonicalHead } from "../lib/site.js";

const {
  title,
  description,
  versionSlug,
  canonicalPath,
  template = "doc",
} = Astro.props;
---

<StarlightPage
  frontmatter={{
    title,
    description,
    template,
    editUrl: false,
    head: canonicalPath ? canonicalHead(canonicalPath) : [],
  }}
>
  <slot />
</StarlightPage>
