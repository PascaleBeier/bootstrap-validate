---
const { version, rules } = Astro.props;
---

<p>{version.note}</p>

<h2>Quick Start</h2>
<p>Include the script, select an input, and attach a rule string.</p>

<pre><code>{`<script src="bootstrap-validate.js"></script>
<script>
bootstrapValidate('#email', 'email:Enter a valid email address');
</script>`}</code></pre>

<h2>Contents</h2>
<ul class="quick-links">
  <li><a href={`/${version.slug}/installation/`}>Installation</a></li>
  <li><a href={`/${version.slug}/usage/`}>Usage</a></li>
  <li><a href={`/${version.slug}/rules/`}>Rules ({rules.length})</a></li>
</ul>
